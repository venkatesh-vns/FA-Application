# Server
PORT=5100
NODE_ENV=development
CLIENT_URL=http://localhost:3100

# Database (PostgreSQL)
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_NAME=fa_management
DB_PORT=5432

# Signed out after this many minutes without activity
SESSION_IDLE_MINUTES=30
# Longest a session can last, however active (seconds; 12 hours)
SESSION_SECONDS=43200

# Time zone used for timestamps shown in the screens and exports
APP_TIME_ZONE=Asia/Kolkata
