# =====================================================================
#  FA Management System - settings (copy to .env next to server.js)
#  The same application build runs on-premises and in the cloud:
#  only this file changes. Restart the application after editing it.
# =====================================================================

# --- Environment ------------------------------------------------------
# production | staging | development  (staging shows an orange STAGING banner)
APP_ENV=production
NODE_ENV=production
# Port the application listens on (screens and API on the same port)
PORT=3100
# Public address users open (used for allowed origins)
CLIENT_URL=http://localhost:3100
# Folder of the built screens (client\build of the release); the API serves them
CLIENT_BUILD_DIR=

# --- Database (PostgreSQL) --------------------------------------------
# Either the five values below ...
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fa_management
DB_USER=fa_app
DB_PASSWORD=change-me
# ... or one connection string (cloud platforms often give this); it wins over DB_*
# DATABASE_URL=postgres://fa_app:password@db.example.com:5432/fa_management
# Encrypted connection: false (office network) | true (encrypted) | verify (encrypted + certificate check)
DB_SSL=false
# For DB_SSL=verify: the CA certificate of the database server (.pem)
# DB_SSL_CA=C:\FA\certs\db-ca.pem
# Connections per application process
DB_POOL_MAX=20
# Year-End Archive database (default: <DB_NAME>_archive on the same server)
# ARCHIVE_DB_NAME=fa_management_archive

# --- Security ---------------------------------------------------------
# Secret that signs the sign-in tokens (JWT): at least 32 random characters,
# different per environment, never shared. setup-environment creates one.
JWT_SECRET=
# Signed out after this many minutes without activity
SESSION_IDLE_MINUTES=30
# Longest a session can last, however active (seconds; 12 hours)
SESSION_SECONDS=43200
# A closed browser frees the user ID for a new sign-in after this many minutes
SESSION_OPEN_MINUTES=3
# Failed sign-in attempts allowed per 15 minutes per address
AUTH_RATE_LIMIT=20

# --- Behind a reverse proxy / HTTPS (cloud) ---------------------------
# Number of proxies in front (Nginx / IIS / load balancer): 1. Empty when users connect directly.
TRUST_PROXY=
# true when the site is served only over https (adds HSTS)
FORCE_HTTPS=false

# --- Time zone ----------------------------------------------------------
# Business time zone: times are saved and shown in it whatever the server clock (cloud servers use UTC)
APP_TIME_ZONE=Asia/Kolkata

# --- Backups ------------------------------------------------------------
# Where backups taken by the application are written (Year-End Archive, deployments)
# BACKUP_DIR=D:\FA\backups
# pg_dump.exe when it is not found automatically (PostgreSQL bin folder)
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\16\bin\pg_dump.exe
