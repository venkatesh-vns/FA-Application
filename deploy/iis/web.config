<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS reverse proxy for FA Management (Windows Server, on-premises or cloud VM)
    Users -> https://fa.company.local -> IIS (SSL certificate on the site binding) -> Node.js app on localhost:3100
  Needs the IIS modules "URL Rewrite" and "Application Request Routing" (ARR):
    IIS Manager > server > Application Request Routing Cache > Server Proxy Settings > Enable proxy.
  Create an IIS site (any empty folder) with an https binding and the certificate, and put this file in that folder.
  In the app's .env set: TRUST_PROXY=1, FORCE_HTTPS=true, CLIENT_URL=https://fa.company.local
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="HTTP to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions><add input="{HTTPS}" pattern="^OFF$" /></conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="FA Management app" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://localhost:3100/{R:1}" />
        </rule>
      </rules>
      <allowedServerVariables>
        <add name="HTTP_X_FORWARDED_PROTO" />
      </allowedServerVariables>
    </rewrite>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="20971520" /><!-- 20 MB Excel uploads -->
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
